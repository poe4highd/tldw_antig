#!/bin/bash
# rt - Read-Tube 服务管理
# 用法: rt [start|stop|restart|status|logs] [service]
SERVICES="tldw-backend tldw-frontend tldw-scheduler cloudflared-tldw"
cmd=${1:-status}
svc=${2:-tldw.target}

case $cmd in
  start)   systemctl --user start $svc && echo "已启动 $svc" ;;
  stop)    systemctl --user stop $svc && echo "已停止 $svc" ;;
  restart) systemctl --user restart $svc && echo "已重启 $svc" && sleep 1 && systemctl --user status $SERVICES --no-pager ;;
  status)  systemctl --user status $SERVICES ;;
  logs)
    if [ -n "$2" ]; then
      journalctl --user -u "$2" -f --output=cat
    else
      journalctl --user -u tldw-backend -u tldw-frontend -u tldw-scheduler -u cloudflared-tldw -f --output=cat
    fi
    ;;
  enable)  systemctl --user enable $SERVICES tldw.target ;;
  disable) systemctl --user disable $SERVICES tldw.target ;;
  *)
    echo "用法: rt [命令] [服务名]"
    echo ""
    echo "命令:"
    echo "  status              查看所有服务状态（默认）"
    echo "  start               启动所有服务"
    echo "  stop                停止所有服务"
    echo "  restart [服务名]    重启所有或指定服务"
    echo "  logs [服务名]       实时日志（默认全部服务）"
    echo ""
    echo "服务名: tldw-backend | tldw-frontend | tldw-scheduler | cloudflared-tldw"
    ;;
esac
